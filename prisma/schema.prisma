// Prisma Schema for Project LOOP — Corporate AI Customer-Feedback Intelligence Platform
// Configured with SQLite for resilient local & development persistence

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  tenantId  String   @unique
  plan      String   @default("Enterprise Dedicated")
  createdAt DateTime @default(now())

  users     User[]
  feedbacks Feedback[]
  themes    Theme[]
  reports   Report[]

  @@index([tenantId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("VIEWER")
  avatar       String?
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  reports Report[]

  @@index([workspaceId])
  @@index([email])
}

model Feedback {
  id             String    @id @default(cuid())
  content        String
  channel        String    @default("SUPPORT_TICKET")
  sourceRef      String?
  customerLabel  String?
  sentiment      String    @default("NEUTRAL")
  sentimentScore Float     @default(0.0) // -1.0 to 1.0
  status         String    @default("NEW")
  featureArea    String?
  rationale      String?
  confidence     Float     @default(0.9)
  arr            Float?    @default(15000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  themes    FeedbackTheme[]
  embedding Embedding?

  @@index([workspaceId])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, channel])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  description String
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbacks FeedbackTheme[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FeedbackTheme {
  id         String @id @default(cuid())
  feedbackId String
  themeId    String
  confidence Float  @default(0.95)

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme    Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, themeId])
  @@index([feedbackId])
  @@index([themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  vectorJson String   // Serialized numeric vector array for semantic retrieval
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}

model Report {
  id          String   @id @default(cuid())
  title       String
  periodStart DateTime
  periodEnd   DateTime
  contentJson String   // Full structured VoC report JSON payload
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  generatedById String?
  generatedBy   User?   @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}
