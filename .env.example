# ==============================================================================
# PROJECT LOOP — Environment Configuration (.env.example)
# Zidio Development Web Track · Corporate-Grade Build
# ==============================================================================

# 1. Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb://localhost:27017/loop_db"
MONGODB_DB_NAME="loop_db"
# Fallback / Prisma SQLite DB
DATABASE_URL="file:./dev.db"

# 2. NextAuth & Session Security Secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="loop_super_secret_session_encryption_key_2026_zidio"
NEXTAUTH_URL="http://localhost:3000"

# 3. AI Intelligence Provider (Anthropic Claude API)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
CLAUDE_MODEL="claude-3-7-sonnet-20250219"

# 4. Optional Webhook & Slack Integrations
SLACK_WEBHOOK_URL="https://your-workspace.slack.com/webhook/sample-placeholder"

# 5. Node Environment
NODE_ENV="development"
